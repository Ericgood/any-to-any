{
  "name": "anytoany",
  "version": "0.0.1",
  "description": "Session-to-session messaging for AI coding agents — let any agent @ any other, across devices and vendors.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://anytoany.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ericgood/any-to-any.git"
  },
  "bin": {
    "anyd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "webui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "bonjour-service": "^1.4.4",
    "commander": "^14.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai-agents",
    "agent-interop",
    "claude-code",
    "codex",
    "session-messaging",
    "multi-agent",
    "agent-skills",
    "cross-device",
    "mdns",
    "cli"
  ],
  "author": "Ericgood and the anytoany agents (https://github.com/Ericgood/any-to-any)",
  "bugs": {
    "url": "https://github.com/Ericgood/any-to-any/issues"
  }
}
